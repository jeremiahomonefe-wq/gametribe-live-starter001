PORT=4000
# Website address(es) allowed to connect; comma separated. Needed when the website is hosted separately (e.g. Vercel).
CLIENT_ORIGIN=http://localhost:5173
# Phone numbers on the join form: required (default), optional, or off
COLLECT_PHONES=required
# Where collected numbers are saved. On Render this must be a persistent disk mount (e.g. /var/data), or they are lost on redeploy.
DATA_DIR=./data
# Set a long random value to enable the /admin/contacts.csv download of everything collected. Leave empty to disable it.
ADMIN_TOKEN=
# Wording shown to players under the phone field
PHONE_NOTICE=The organisers use your number to reach you, for example if you win. It is not shown to other players.
